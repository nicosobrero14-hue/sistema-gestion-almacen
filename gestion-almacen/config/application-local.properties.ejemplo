# Copiar este archivo como application-local.properties, en esta misma carpeta, y completar
# con los datos propios. El archivo real no se sube al repositorio.
#
# Va en config/ y no adentro de src/main/resources a proposito: lo que esta en resources
# termina empaquetado dentro del jar, y las credenciales no pueden viajar ahi. Spring Boot
# lee la carpeta config/ que encuentra al lado de donde se ejecuta, asi que el mismo archivo
# sirve mientras se desarrolla y una vez instalado al lado del programa.

spring.datasource.username=root
spring.datasource.password=tu_clave_de_mysql

# Cobro con MercadoPago (RF-05 / CU-10). Salen de Tus integraciones > Datos de integracion.
# Durante el desarrollo van las credenciales de prueba: los cobros son simulados.
mercadopago.access-token=APP_USR-tu_access_token
mercadopago.user-id=tu_user_id
# Sucursal y caja creadas en la cuenta. Sin estos datos no se pueden generar cobros.
mercadopago.store-id=tu_store_id
mercadopago.pos-external-id=ALMACEN01CAJA01

# Puerto serie de la balanza (RF-12). Depende del equipo: en el Administrador de dispositivos,
# en "Puertos (COM y LPT)". Vacio o sin esta linea significa que el equipo no tiene balanza y
# el peso se escribe a mano.
scale.port=COM3
